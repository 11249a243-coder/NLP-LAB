    {
      "cell_type": "code",
      "source": [
        "words = [\"box\", \"city\", \"child\", \"boy\", \"bus\", \"knife\"]\n",
        "\n",
        "irregular = {\n",
        "    \"child\": \"children\",\n",
        "    \"knife\": \"knives\"\n",
        "}\n",
        "\n",
        "for word in words:\n",
        "    if word in irregular:\n",
        "        plural = irregular[word]\n",
        "    elif word.endswith((\"s\", \"x\", \"z\", \"ch\", \"sh\")):\n",
        "        plural = word + \"es\"\n",
        "    elif word.endswith(\"y\") and word[-2] not in \"aeiou\":\n",
        "        plural = word[:-1] + \"ies\"\n",
        "    else:\n",
        "        plural = word + \"s\"\n",
        "\n",
        "    print(word, \"->\", plural)"
      ],
