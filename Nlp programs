        "Q28. Viterbi Algorithm"
      ],
      "metadata": {
        "id": "r8wO_HwsKH89"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "words = [\"the\", \"dog\", \"barks\"]\n",
        "tags = [\"D\", \"N\", \"V\"]\n",
        "\n",
        "trans = {\n",
        "    (\"<s>\", \"D\"): 0.6,\n",
        "    (\"<s>\", \"N\"): 0.3,\n",
        "    (\"<s>\", \"V\"): 0.1,\n",
        "    (\"D\", \"D\"): 0.05,\n",
        "    (\"D\", \"N\"): 0.9,\n",
        "    (\"D\", \"V\"): 0.05,\n",
        "    (\"N\", \"D\"): 0.2,\n",
        "    (\"N\", \"N\"): 0.2,\n",
        "    (\"N\", \"V\"): 0.6,\n",
        "    (\"V\", \"D\"): 0.6,\n",
        "    (\"V\", \"N\"): 0.3,\n",
        "    (\"V\", \"V\"): 0.1\n",
        "}\n",
        "\n",
        "emit = {\n",
        "    (\"the\", \"D\"): 0.7,\n",
        "    (\"dog\", \"N\"): 0.3,\n",
        "    (\"dog\", \"V\"): 0.01,\n",
        "    (\"barks\", \"N\"): 0.1,\n",
        "    (\"barks\", \"V\"): 0.2\n",
        "}\n",
        "\n",
        "dp = []\n",
        "path = []\n",
        "\n",
        "first = {}\n",
        "\n",
        "for tag in tags:\n",
        "    first[tag] = trans[(\"<s>\", tag)] * emit.get((words[0], tag), 0)\n",
        "\n",
        "dp.append(first)\n",
        "path.append({tag: None for tag in tags})\n",
        "\n",
        "for word in words[1:]:\n",
        "    current = {}\n",
        "    back = {}\n",
        "\n",
        "    for tag in tags:\n",
        "        values = [\n",
        "            dp[-1][prev] * trans[(prev, tag)] *\n",
        "            emit.get((word, tag), 0)\n",
        "            for prev in tags\n",
        "        ]\n",
        "\n",
        "        best = max(values)\n",
        "        current[tag] = best\n",
        "\n",
        "        if best > 0:\n",
        "            back[tag] = tags[values.index(best)]\n",
        "        else:\n",
        "            back[tag] = None\n",
        "\n",
        "    dp.append(current)\n",
        "    path.append(back)\n",
        "\n",
        "best_tag = max(tags, key=lambda t: dp[-1][t])\n",
        "\n",
        "result = [best_tag]\n",
        "\n",
        "for i in range(len(words)-1, 0, -1):\n",
        "    best_tag = path[i][best_tag]\n",
        "    result.append(best_tag)\n",
        "\n",
        "result.reverse()\n",
        "\n",
        "print(\"Words:\", words)\n",
        "print(\"Best Tags:\", result)\n",
        "print(\"Probability:\", dp[-1][result[-1]])"
      ],
