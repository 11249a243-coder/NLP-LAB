    {
      "cell_type": "code",
      "source": [
        "from collections import Counter\n",
        "\n",
        "sentences = [\n",
        "    [\"<s>\", \"I\", \"love\", \"NLP\", \"</s>\"],\n",
        "    [\"<s>\", \"I\", \"love\", \"deep\", \"learning\", \"</s>\"],\n",
        "    [\"<s>\", \"I\", \"study\", \"NLP\", \"</s>\"],\n",
        "    [\"<s>\", \"You\", \"love\", \"NLP\", \"</s>\"]\n",
        "]\n",
        "\n",
        "uni = Counter()\n",
        "bi = Counter()\n",
        "\n",
        "for s in sentences:\n",
        "    uni.update(s[:-1])\n",
        "    for i in range(len(s)-1):\n",
        "        bi[(s[i], s[i+1])] += 1\n",
        "\n",
        "total = 17\n",
        "lam = 0.7\n",
        "alpha = 0.4\n",
        "\n",
        "def interpolation(w1, w2):\n",
        "    p1 = bi[(w1, w2)] / uni[w1] if uni[w1] else 0\n",
        "    p2 = uni[w2] / total\n",
        "    return lam * p1 + (1-lam) * p2\n",
        "\n",
        "def backoff(w1, w2):\n",
        "    if bi[(w1, w2)] > 0:\n",
        "        return bi[(w1, w2)] / uni[w1]\n",
        "    return alpha * uni[w2] / total\n",
        "\n",
        "print(\"Interpolation love|I:\", round(interpolation(\"I\", \"love\"), 3))\n",
        "print(\"Interpolation study|You:\", round(interpolation(\"You\", \"study\"), 3))\n",
        "\n",
        "print(\"Backoff study|You:\", round(backoff(\"You\", \"study\"), 3))\n",
        "print(\"Backoff love|I:\", round(backoff(\"I\", \"love\"), 3))"
      ],
