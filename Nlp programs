      "source": [
        "Q16. Building a Bigram Model"
      ],
      "metadata": {
        "id": "ipfNnpTAHA4H"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from collections import Counter\n",
        "\n",
        "sentences = [\n",
        "    [\"<s>\", \"I\", \"love\", \"NLP\", \"</s>\"],\n",
        "    [\"<s>\", \"I\", \"love\", \"deep\", \"learning\", \"</s>\"],\n",
        "    [\"<s>\", \"I\", \"study\", \"NLP\", \"</s>\"],\n",
        "    [\"<s>\", \"You\", \"love\", \"NLP\", \"</s>\"]\n",
        "]\n",
        "\n",
        "unigrams = Counter()\n",
        "bigrams = Counter()\n",
        "\n",
        "for sentence in sentences:\n",
