      }
    },
    {
      "cell_type": "code",
      "source": [
        "from collections import Counter, defaultdict\n",
        "\n",
        "sentences = [\n",
        "    [(\"the\", \"D\"), (\"dog\", \"N\"), (\"barks\", \"V\")],\n",
        "    [(\"a\", \"D\"), (\"cat\", \"N\"), (\"sleeps\", \"V\")],\n",
        "    [(\"dogs\", \"N\"), (\"bark\", \"V\")],\n",
        "    [(\"the\", \"D\"), (\"cat\", \"N\"), (\"chases\", \"V\"),\n",
        "     (\"the\", \"D\"), (\"dog\", \"N\")]\n",
        "]\n",
        "\n",
        "transitions = Counter()\n",
        "emissions = Counter()\n",
        "tag_counts = Counter()\n",
        "\n",
        "for s in sentences:\n",
        "    previous = \"<s>\"\n",
        "\n",
        "    for word, tag in s:\n",
        "        transitions[(previous, tag)] += 1\n",
        "        emissions[(tag, word)] += 1\n",
        "        tag_counts[tag] += 1\n",
        "        previous = tag\n",
        "\n",
        "    transitions[(previous, \"</s>\")] += 1\n",
        "\n",
        "print(\"Transition Probabilities:\")\n",
